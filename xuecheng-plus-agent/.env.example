# =============================================
# 学成在线门户 AI 助手模块 - 环境配置模板
# 复制为 .env 并按实际环境填写
# =============================================

# ---------- 服务 ----------
APP_NAME=学成在线AI助手
HOST=0.0.0.0
PORT=8000

# ---------- JWT（必须与 Java 门户工程共享同一密钥） ----------
JWT_SECRET=please-change-me-shared-jwt-secret
JWT_ALGORITHM=HS256

# ---------- 阿里百炼（留空 DASHSCOPE_API_KEY 则进入无Key降级模式） ----------
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.7
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ---------- MySQL（复用学成在线业务库，AI模块自建表） ----------
MYSQL_HOST=192.168.101.65
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=mysql
MYSQL_DB=xcplus_agent

# ---------- RabbitMQ ----------
RABBITMQ_HOST=192.168.101.65
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=rabbitmq
RABBITMQ_VHOST=/
RABBIT_EXCHANGE=xc.lecture
RABBIT_QUEUE=xc.lecture.parse
RABBIT_ROUTING_KEY=lecture.upload
RABBIT_CONSUMER_ENABLED=true

# ---------- MinIO ----------
MINIO_ENDPOINT=192.168.101.65:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=lecture

# ---------- 学成在线 Java 后端 ----------
# 课程列表接口地址（留空则课程工具使用本地演示数据跑通流程）
JAVA_BASE_URL=
COURSE_LIST_PATH=/api/course/list
LECTURE_CALLBACK_PATH=/api/lecture/parse-status
# 课程详情页 URL 模板（{id} 会被替换为课程ID；留空则使用课程接口返回的 url 字段）
JAVA_COURSE_DETAIL_URL_TEMPLATE=

# ---------- 记忆 ----------
MEMORY_TOKEN_THRESHOLD=2000
HISTORY_MAX_TURNS=20

# ---------- RAG ----------
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=course_lectures
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.7
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RRF_K=60
